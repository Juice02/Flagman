# Copy to .env and change the passwords: cp .env.example .env
# .env is git-ignored. Used by Docker Compose and by the app when run on the host.

# MySQL container
MYSQL_ROOT_PASSWORD=change-me-root
# Host port for MySQL (3307 avoids clashing with a locally installed MySQL on 3306)
MYSQL_PORT=3307

# App database connection (the MySQL container creates this user and database)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=feature_flag_system
DB_USER=flagman
DB_PASSWORD=change-me-app

# Host port for the app container
APP_PORT=8081

# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Host port for the dashboard container (the Vite dev server uses 5173)
DASHBOARD_PORT=8080
